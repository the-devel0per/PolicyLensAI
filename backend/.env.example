# Copy to .env for local runs. NEVER commit .env.
# On Lambda, set GEMINI_API_KEY, GEMINI_MODEL and TABLE_NAME as function environment variables
# (AWS_REGION is set by Lambda automatically).

GEMINI_API_KEY=your-gemini-api-key
# Primary model. Check the current model names in Google AI Studio before deploying.
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated fallbacks tried after the primary model.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

TABLE_NAME=policylens-history

# Local runs only (uses your `aws configure` credentials). Not needed on Lambda.
AWS_REGION=ap-south-1
